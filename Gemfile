source "https://rubygems.org"

# Pinned to match what we build locally and what the Actions workflow runs.
gem "jekyll", "~> 4.4.1"

# Needed for `jekyll serve` on Ruby 3+, where webrick left the stdlib.
gem "webrick", "~> 1.9"

# Timezone data for platforms that don't ship it.
gem "tzinfo-data", platforms: [:windows, :jruby]
